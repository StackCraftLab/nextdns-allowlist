# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env. Generate secrets with: openssl rand -hex 32

# NextDNS profile and API key (key from https://my.nextdns.io/account).
# WARNING: NextDNS API keys are account-wide; see SECURITY.md.
NEXTDNS_PROFILE_ID=59b6c8
NEXTDNS_API_KEY=replace_with_api_key

# Login name for the single administrator. The password is NOT set here:
# run `docker compose exec app python -m app.manage set-password` instead.
APP_USERNAME=admin

# Optional: supply the admin password as an Argon2id hash instead of set-password
# (python -m app.manage hash-password). In this file every "$" must be written as "$$".
# APP_ADMIN_PASSWORD_HASH=

# Long random secret (>= 32 chars) used to key session/CSRF token hashes.
APP_SECRET_KEY=replace_with_a_long_random_secret

# production (default) forces Secure cookies; use development only for local HTTP testing.
APP_ENV=production

# Comma-separated public hostname(s) the app is served under (Host header check).
APP_ALLOWED_HOSTS=allowlist.example.com

# Optional tuning
# APP_SESSION_IDLE_MINUTES=30
# APP_SESSION_ABSOLUTE_HOURS=12
